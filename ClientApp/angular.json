{
  "version": 1,
  "cli": {
    "analytics": false,
    "schematicCollections": ["@angular/cli"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "text-viewer": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "../wwwroot",
              "browser": ""
            },
            "index": false,
            "deleteOutputPath": false,
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "assets": [],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [],
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
