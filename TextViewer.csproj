<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TextViewer</RootNamespace>
    <AssemblyName>TextViewer</AssemblyName>
    <!-- Single-file publishing configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <!-- Embed wwwroot as resources instead of copying as content files -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.1" />
  </ItemGroup>

  <!-- Embed wwwroot files as resources so everything is in the single executable -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
    <!-- Exclude test project from main compilation -->
    <Compile Remove="TextViewer.Tests\**" />
    <Content Remove="TextViewer.Tests\**" />
    <None Remove="TextViewer.Tests\**" />
    <EmbeddedResource Remove="TextViewer.Tests\**" />
  </ItemGroup>

  <!-- Build Angular app before C# build -->
  <Target Name="BuildAngular" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Building Angular application..." />
    <!-- Install npm deps if node_modules missing -->
    <Exec Command="npm ci" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp\node_modules')" />
    <Exec Command="npx ng build --configuration production" WorkingDirectory="ClientApp" />
  </Target>

</Project>
